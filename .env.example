# 复制为 .env.dev 后按本地环境填写；生产环境应由部署平台注入变量。
NODE_ENV=dev
APP_PORT=8000
SESSION_TYPE=jwt
MOCK_LOGIN_ENABLED=false
SWAGGER_ENABLED=true
PAYMENT_DRIVER=mock

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-password
MYSQL_DB=youlai_admin
TYPEORM_LOGGING=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-local-password
REDIS_PREFIX=app:

JWT_SECRET_KEY=replace-with-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7200
JWT_ISSUER=yueji

ORDER_PAY_TIMEOUT_MINUTES=30
PAYMENT_ATTEMPT_LEASE_MINUTES=5

OSS_TYPE=minio
OSS_MINIO_ENDPOINT=http://localhost:9000
OSS_MINIO_ACCESS_KEY=replace-with-local-access-key
OSS_MINIO_SECRET_KEY=replace-with-local-secret-key
OSS_MINIO_BUCKET=public
OSS_MINIO_CUSTOM_DOMAIN=
OSS_ALIYUN_ENDPOINT=
OSS_ALIYUN_ACCESS_KEY_ID=
OSS_ALIYUN_ACCESS_KEY_SECRET=
OSS_ALIYUN_BUCKET=
OSS_LOCAL_STORAGE_PATH=./uploads/
OSS_UPLOAD_MAX_SIZE=52428800
OSS_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

WX_MINIAPP_APP_ID=
WX_MINIAPP_APP_SECRET=
# 仅 PAYMENT_DRIVER=wechat 时需要。私钥优先使用部署平台文件挂载，切勿提交真实密钥。
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_MERCHANT_SERIAL_NO=
WX_PAY_MERCHANT_PRIVATE_KEY=
WX_PAY_MERCHANT_PRIVATE_KEY_PATH=
# JSON 对象：{"平台证书序列号或公钥ID":"PEM内容"}，轮换时可同时保留新旧密钥。
WX_PAY_PLATFORM_KEYS_JSON={}
WX_PAY_NOTIFY_URL=
WX_PAY_REFUND_NOTIFY_URL=
