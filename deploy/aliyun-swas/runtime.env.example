# 复制到服务器的 /opt/yueji/shared/runtime.env，并设置权限为 600。
# 所有密码都应使用高强度随机值；不要提交真实凭据。
PUBLIC_BASE_URL=http://47.100.53.222
MYSQL_ROOT_PASSWORD=replace-with-random-secret
MYSQL_APP_PASSWORD=replace-with-random-secret
REDIS_PASSWORD=replace-with-random-secret
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret
JWT_SECRET_KEY=replace-with-random-secret-at-least-32-characters
WX_MINIAPP_APP_ID=
WX_MINIAPP_APP_SECRET=
PAYMENT_DRIVER=disabled
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_MERCHANT_SERIAL_NO=
WX_PAY_MERCHANT_PRIVATE_KEY_PATH=/opt/yueji/shared/secrets/wechat/apiclient_key.pem
# 使用单引号保留 JSON 双引号与 PEM 中的 \n；不得提交真实公钥配置。
WX_PAY_PLATFORM_KEYS_JSON='{}'
WX_PAY_NOTIFY_URL=https://lumiere.love/prod-api/api/v1/app/payment/wechat/notify
WX_PAY_REFUND_NOTIFY_URL=https://lumiere.love/prod-api/api/v1/app/payment/wechat/refund-notify

